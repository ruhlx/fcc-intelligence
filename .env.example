# --- LLM provider ---
# "openai" or "gemini" — selects the Stage 4 extraction backend.
LLM_PROVIDER=openai

# --- OpenAI (used when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-2024-08-06

# --- Google Gemini (used when LLM_PROVIDER=gemini) ---
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-flash-latest

# --- Database ---
# Fully local (no server): a SQLite file. For docker-compose use host "db";
# for Postgres use postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=sqlite:///./fcc.db

# --- Storage ---
DATA_DIRECTORY=./data

# --- Logging ---
LOG_LEVEL=INFO
# json for production, console for local development
LOG_FORMAT=console

# --- API / CORS ---
# Comma-separated browser origins allowed to call the API (the SPA's origin).
# Use "*" to allow any origin (fine for this single-tenant tool).
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:4173

# Optional: when set, POST /ingest requires header  X-Ingest-Token: <value>
INGEST_TOKEN=

# Run `alembic upgrade head` automatically on startup. Handy on hosts without a
# (paid) pre-deploy step, e.g. Render free tier. Leave false for local/CLI use.
AUTO_MIGRATE=false

# --- Crawler ---
FCC_BASE_URL=https://apps.fcc.gov/oetcf/eas/reports
HTTP_TIMEOUT=30.0
HTTP_MAX_RETRIES=3
CRAWL_CONCURRENCY=4
# Max filings processed per company.
FCC_MAX_FILINGS=10
# false = structured 731 Responsible Party only (no LLM). true = also download
# and LLM-mine exhibit PDFs. The CLI --pdfs flag overrides this per run.
EXTRACT_PDFS=false
